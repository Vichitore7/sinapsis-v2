# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a Git.
ENTORNO=desarrollo
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./selva.db
# Base COMPARTIDA del equipo (PostgreSQL en la nube, p. ej. Neon o Supabase). El driver ya viene instalado.
# Pega la URL que te dé el servicio cambiando el inicio "postgresql://" por "postgresql+psycopg://" y conserva ?sslmode=require:
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@host/selva?sslmode=require
CORS_ORIGENES=http://localhost:5173
SESION_DIAS=30
